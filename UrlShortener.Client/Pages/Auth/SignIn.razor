@using System.ComponentModel.DataAnnotations

@inject Handlers.ApiHandler ApiHandler
@inject NavigationManager Nav

@layout AuthLayout

@page "/Auth/SignIn"


<PageTitle>Sign in</PageTitle>

<h1>Welcome back</h1>
<p class="auth-sub">Sign in to manage your short links.</p>

<EditForm Model="model" OnValidSubmit="Submit" class="auth-form">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="auth-alert" role="alert">@error</div>
    }

    <div class="field">
        <label for="username">Username</label>
        <InputText id="username" type="text" @bind-Value="model.Username" autocomplete="username" placeholder="Username" />
        <ValidationMessage For="() => model.Username" />
    </div>

    <div class="field">
        <label for="password">Password</label>
        <InputText id="password" type="password" @bind-Value="model.Password" autocomplete="current-password" placeholder="Your password" />
        <ValidationMessage For="() => model.Password" />
    </div>

    <button type="submit" class="btn-primary" disabled="@busy">
        @(busy ? "Signing in…" : "Sign in")
    </button>
</EditForm>

<p class="auth-switch">New here? <a href="auth/register">Create an account</a></p>



@code {

    private LoginModel model = new();
    private bool busy;
    private string? error;



    private async Task Submit()
    {
        busy = true;
        error = null;

        var result = await ApiHandler.Send(HttpMethod.Post, "Auth/Login", new { model.Username, model.Password });

        busy = false;

        if (result.Success)
        {
            Nav.NavigateTo("/dashboard");
        }
        else
        {
            error = result.Error ?? "Invalid login credentials";
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Enter your username.")]
        public string Username { get; set; } = "";

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = "";
    }
}