@using System.ComponentModel.DataAnnotations
@using UrlShortener.Dtos.Auth.Response

@inject Handlers.ApiHandler ApiHandler
@inject NavigationManager Nav

@layout AuthLayout

@page "/Auth/SignIn"


<PageTitle>Sign in</PageTitle>

<h1>Welcome back</h1>
<p class="auth-sub">Sign in to manage your short links.</p>

<EditForm Model="model" OnValidSubmit="Submit" class="auth-form">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="auth-alert" role="alert">@error</div>
    }

    <div class="field">
        <label for="email">Email</label>
        <InputText id="email" type="email" @bind-Value="model.Email" autocomplete="email" placeholder="you@example.com" />
        <ValidationMessage For="() => model.Email" />
    </div>

    <div class="field">
        <label for="password">Password</label>
        <InputText id="password" type="password" @bind-Value="model.Password" autocomplete="current-password" placeholder="Your password" />
        <ValidationMessage For="() => model.Password" />
    </div>

    <button type="submit" class="btn-primary" disabled="@busy">
        @(busy ? "Signing in…" : "Sign in")
    </button>
</EditForm>

<p class="auth-switch">New here? <a href="auth/register">Create an account</a></p>



@code {

    private LoginModel model = new();
    private bool busy;
    private string? error;



    private async Task Submit()
    {
        busy = true;
        error = null;

        var result = await ApiHandler.Send<LoginResponse>(HttpMethod.Post, "Auth/Login", new { model.Email, model.Password });

        busy = false;

        if (result.Success && !string.IsNullOrEmpty(result.Data?.JwtToken))
        {
            //await JS.InvokeVoidAsync("localStorage.setItem", "token", result.Data.JwtToken);
            Nav.NavigateTo("/dashboard");
        }
        else
        {
            error = result.Error ?? "Email or password is incorrect.";
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Enter your email.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = "";
    }
}